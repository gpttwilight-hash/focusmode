# Required for local auth/database testing
DATABASE_URL="postgres://postgres:postgres@localhost:5432/focusflow"
AUTH_SECRET="replace-with-at-least-24-random-characters"

# Google OAuth sign-in
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional until a domain/email provider is ready.
# Without these, FocusFlow logs verification codes in the dev server output.
RESEND_API_KEY=""
EMAIL_FROM=""

# Optional free/low-cost transactional email path.
# If RESEND_API_KEY is empty and BREVO_API_KEY is present, FocusFlow sends real email via Brevo.
BREVO_API_KEY=""
